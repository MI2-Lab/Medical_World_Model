+    validation_prediction_calls = 0
+
+    def maxed_fit(model: object, matrix: np.ndarray, labels: np.ndarray) -> object:
+        fitted = original_fit(model, matrix, labels)
+        fitted.n_iter_ = np.asarray([fitted.max_iter], dtype=np.int64)
