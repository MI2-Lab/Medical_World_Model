+    monkeypatch.setattr(
+        evaluation_module.LogisticRegression, "predict_proba", tracked_predict_proba
+    )
+    with pytest.raises(RuntimeError, match="strictly before max_iter"):
+        select_logistic(
+            train_x,
+            train_y,
+            validation_x,
+            validation_y,
