  "fusion": {
    "formula": "logit(pCR)=logit(C+FTV)+alpha+beta*image_logit",
    "inner_oof_folds": 3,
    "image_logits": "nested inner-OOF, no in-sample logits",
    "timings": ["T0", "T0-T1", "T0-T2", "T0-T3"]
  },
  "bootstrap": {"replicates": 2000, "unit": "patient", "stratified": true},
  "gate": {
    "both_early_delta_auroc_positive": true,
    "early_macro_delta_auroc_min": 0.02,
    "positive_seed_count": 4,
    "bootstrap_lower_bound_gt_zero": true,
    "auprc_not_decreased": true,
    "brier_improved": true,
    "spatial_extra_delta_auroc_min": 0.01
