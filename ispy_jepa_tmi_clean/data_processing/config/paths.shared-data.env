# Shared data paths on the current lab server.
# These paths are under /data and should be accessible to users on this machine
# with the appropriate dataset permissions.
#
# This file intentionally does not contain /home/<user> paths.
# To rerun DICOM conversion, set DCM2NIIX in your own local env file or PATH.
# To rerun the BreastDCEDL timing audit, set BREASTDCEDL_METADATA_CSV to a
# shared or local copy of BreastDCEDL_metadata_min_crop.csv.

ISPY2_RAW_ROOT=/data/data/Breast_Cancer/I-SPY2
ISPY1_RAW_ROOT=/data/data/Breast_Cancer/I-SPY1

ISPY2_PREPROCESSED_ROOT=/data/data/Preprocessed/I-SPY2
ISPY1_PREPROCESSED_ROOT=/data/data/Preprocessed/I-SPY1

DCM2NIIX=dcm2niix
BREASTDCEDL_METADATA_CSV=BreastDCEDL_metadata_min_crop.csv
