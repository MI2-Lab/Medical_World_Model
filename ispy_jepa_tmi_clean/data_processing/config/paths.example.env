# Copy this file to a machine-local env file, for example:
#   cp paths.example.env paths.local.env
# Then edit the paths for that machine and run:
#   python3 scripts/run_data_processing.py --env-file config/paths.local.env --stage check
#
# Do not commit private data paths in a paper-facing repository.

ISPY2_RAW_ROOT=/path/to/I-SPY2
ISPY1_RAW_ROOT=/path/to/I-SPY1

ISPY2_PREPROCESSED_ROOT=/path/to/preprocessed/I-SPY2
ISPY1_PREPROCESSED_ROOT=/path/to/preprocessed/I-SPY1

DCM2NIIX=/path/to/dcm2niix
BREASTDCEDL_METADATA_CSV=/path/to/BreastDCEDL_metadata_min_crop.csv

# Optional. By default the clean runner uses ../preprocessing relative to itself.
PREPROCESSING_DIR=/path/to/ispy_jepa_tmi_clean/data_processing/preprocessing
